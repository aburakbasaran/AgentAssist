{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AgentAssist": {
    "Mode": "Mock",
    "MinChunkScore": 0.7,
    "MaxRetrievedChunks": 4,
    "RetrievalTimeoutSeconds": 10,
    "ChatTimeoutSeconds": 30,
    "AllowHeaderUserContext": true
  },
  "AzureSearch": {
    "Endpoint": "<set-via-keyvault>",
    "IndexName": "agentassist-knowledge",
    "SemanticConfigurationName": "agentassist-semantic",
    "VectorFieldName": "contentVector"
  },
  "AzureOpenAI": {
    "Endpoint": "<set-via-keyvault>",
    "ChatDeploymentName": "<set-via-keyvault>",
    "EmbeddingDeploymentName": "<set-via-keyvault>",
    "MaxOutputTokens": 800,
    "Temperature": 0.0,
    "HealthCacheSeconds": 60
  },
  "AzureSql": {
    "ConnectionString": "<set-via-keyvault>"
  },
  "ApplicationInsights": {
    "ConnectionString": "<set-via-keyvault>"
  },
  "AllowedHosts": "*"
}
